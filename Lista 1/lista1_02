*/


// Código corrigido: 

#include <iostream>
using namespace std;

int main() {
    int numero;
    cout << "Digite um número: "; cin >> numero;
    cout << "Quadrado: " << numero*numero << "\nQuinta parte: " << (numero*numero)/5;
    
    return 0;
}
